#!/bin/sh
# Hook de Git (Modulo 7): se ejecuta solo antes de cada commit y lo cancela si una comprobacion falla.
# Solo actua cuando el commit toca archivos de Capstone_Dilitio_Wine/ (el repositorio tiene otros modulos).
RAIZ=$(git rev-parse --show-toplevel)
CAP="$RAIZ/Capstone_Dilitio_Wine"
if ! git diff --cached --name-only | grep -q '^Capstone_Dilitio_Wine/'; then
  echo "[hook] El commit no toca Capstone_Dilitio_Wine/: se omiten las comprobaciones."
  exit 0
fi

if [ -x "$CAP/.venv/bin/python" ]; then PY="$CAP/.venv/bin/python"                 # Mac y Linux
elif [ -x "$CAP/.venv/Scripts/python.exe" ]; then PY="$CAP/.venv/Scripts/python.exe"  # Windows
else PY="python"; fi

# Comprobacion 1 · las pruebas automaticas.
echo "[hook 1/2] Ejecutando pytest antes del commit..."
( cd "$CAP" && "$PY" -m pytest -q )
if [ $? -ne 0 ]; then
  echo "[hook] Las pruebas fallaron: commit cancelado."
  exit 1
fi

# Comprobacion 2 · ninguna clave ni secreto en lo que se va a confirmar.
echo "[hook 2/2] Buscando claves o secretos en los archivos del commit..."
SECRETOS=$(git diff --cached -U0 -- Capstone_Dilitio_Wine ':!Capstone_Dilitio_Wine/hooks' | grep -E '^\+' | grep -E 'sk-ant-|ANTHROPIC_API_KEY *= *[A-Za-z0-9_-]{8,}|BEGIN (RSA|OPENSSH) PRIVATE KEY|ghp_[A-Za-z0-9]{20,}')
if [ -n "$SECRETOS" ]; then
  echo "$SECRETOS"
  echo "[hook] Posible clave o secreto en el commit: cancelado."
  exit 1
fi
echo "[hook] Comprobaciones superadas."
